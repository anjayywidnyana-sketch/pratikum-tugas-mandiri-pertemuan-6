<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Manajemen Warung Sembako</title>
</head>
<body>

    <h1>Daftar Barang Warung Sembako</h1>

    <a href="/barang/tambah">+ Tambah Barang</a>

    <br><br>

    <table border="1" cellpadding="10">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nama Barang</th>
                <th>Kategori</th>
                <th>Deskripsi</th>
                <th>Harga</th>
                <th>Stok</th>
                <th>Status</th>
                <th>Tanggal Masuk</th>
                <th>Aksi</th>
            </tr>
        </thead>

        <tbody>
            <% if (barang.length === 0) { %>
                <tr>
                    <td colspan="9">
                        Belum ada data barang.
                    </td>
                </tr>
            <% } %>

            <% barang.forEach(item => { %>
                <tr>
                    <td><%= item.id %></td>

                    <td><%= item.nama_barang %></td>

                    <td><%= item.kategori %></td>

                    <td><%= item.deskripsi %></td>

                    <td>
                        Rp <%= Number(item.harga).toLocaleString('id-ID') %>
                    </td>

                    <td><%= item.stok %></td>

                    <td><%= item.status %></td>

                    <td>
                        <%= new Date(item.tanggal_masuk)
                            .toLocaleDateString('id-ID') %>
                    </td>

                    <td>
                        <a href="/barang/edit/<%= item.id %>">
                            Edit
                        </a>

                        <form
                            action="/barang/hapus/<%= item.id %>"
                            method="POST"
                            style="display:inline;"
                            onsubmit="return confirm('Yakin ingin menghapus barang ini?');"
                        >
                            <button type="submit">
                                Hapus
                            </button>
                        </form>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>

</body>
</html>